# Copy to your per-user settings location (see docs/settings.md), or point
# WORKCOPY_SETTINGS at it. Every line is optional.
#   Windows: %APPDATA%\Workcopy\workcopy.env
#   macOS:   ~/Library/Application Support/Workcopy/workcopy.env
#   Linux:   ~/.config/workcopy/workcopy.env

# Where lanes live (otherwise a directory beside each checkout)
# WORKCOPY_ROOT=D:\workcopy-lanes

# Owner configuration: projects, profiles, destroy.discard for build output
# WORKCOPY_CONFIG=C:\Users\you\my.workcopy.json

# MCP server limits and deadline (a flag on the server overrides these)
WORKCOPY_TOOL_TIMEOUT=15m
WORKCOPY_MAX_LANES=32
WORKCOPY_RESERVE_MIB=8192
# WORKCOPY_ALLOW_SHARE_TARGET=D:\packages-cache

# Which agent tools a lane serves. auto: the calling MCP client decides (all when unknown).
# WORKCOPY_AGENTS=auto
# WORKCOPY_AGENTS=kiro,codex

# Under WSL with the repository on /mnt/c, keep lane storage on the WSL filesystem:
# measured 12x faster to create and 12x faster to review (docs/troubleshooting.md)
# WORKCOPY_ROOT=/home/you/.workcopy/lanes

# Agent instruction files copied into every lane (docs/agent-context.md)
# WORKCOPY_AGENT_CONTEXT_INCLUDE=docs/agents/**;.team/rules/**
# WORKCOPY_AGENT_CONTEXT_EXCLUDE=.kiro/specs/**

# Opt-in tool configuration (owner only; agents cannot set this). Credentials stay refused
# unless the exact file is listed under SECRETS.
# WORKCOPY_AGENT_CONTEXT_CONFIG=.kiro/settings/mcp.json
# WORKCOPY_AGENT_CONTEXT_SECRETS=.mytool/.env
