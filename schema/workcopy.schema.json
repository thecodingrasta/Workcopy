{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workcopy configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultProfile": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "enum": [
              "generic",
              "dotnet",
              "node",
              "go",
              "auto"
            ]
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencyClosure": {
            "enum": [
              "strict",
              "include"
            ]
          }
        }
      }
    }
  }
}
